# Private AI Music Producer — local config
# Copy to .env and adjust. Never commit real secrets.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
WORKSPACE_DIR=workspace
DATABASE_URL=sqlite:///workspace/music_ai.db

# DAW mode: simulation | midi_export | postfader (postfader only when probed live)
DAW_MODE=simulation

# Optional LLM (opt-in; Phase 0 does not require)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_PROVIDER=stub

# Privacy: never send raw audio to cloud unless explicitly enabled
ALLOW_CLOUD_AUDIO=false
ALLOW_CLOUD_LLM=false

# Paths on the user's Apple Silicon Mac (N/A in cloud CI)
# FL_STUDIO_PATH=
# POSTFADER_PATH=
