# Private AI Music Producer — local config
# Copy to .env and adjust. Never commit real secrets.

# Runtime
APP_ENV=development
LOG_LEVEL=INFO
WORKSPACE_DIR=workspace
DATABASE_URL=sqlite:///workspace/music_ai.db

# DAW mode: simulation | midi_export | postfader
# postfader selects PostFaderStubAdapter until probed live on Mac — compose/full-compose
# FAIL (DawWriteError) rather than return OK with buried daw.succeeded=False.
# Use simulation or midi_export for CI / day-to-day until live PostFader is verified.
DAW_MODE=simulation

# Optional LLM (opt-in; Phase 0 does not require)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
LLM_PROVIDER=stub

# Privacy: never send raw audio to cloud unless explicitly enabled
ALLOW_CLOUD_AUDIO=false
ALLOW_CLOUD_LLM=false

# Paths on the user's Apple Silicon Mac (N/A in cloud CI)
# FL_STUDIO_PATH=
# POSTFADER_PATH=

# Phase 2 audio adapters (defaults = no large downloads)
MUSIC_AI_SEPARATOR=simulation
MUSIC_AI_TRANSCRIBER=stub
# PREFER_LIBROSA=false

# Phase 5 taste encoder (defaults = simulation CIR projection; no CLAP/MERT download)
# Settings honor MUSIC_AI_ALLOW_ENCODER_DOWNLOAD (also accepts bare ALLOW_ENCODER_DOWNLOAD).
TASTE_ENCODER=simulation
MUSIC_AI_ALLOW_ENCODER_DOWNLOAD=false

# Phase 7 research (defaults = deterministic / stub; no foundation downloads)
MIDI_SPECIALIST=deterministic
VOCAL_WORKFLOW=stub
MUSIC_AI_ALLOW_SPECIALIST_DOWNLOAD=false
MUSIC_AI_ALLOW_VOCAL_MODEL_DOWNLOAD=false
